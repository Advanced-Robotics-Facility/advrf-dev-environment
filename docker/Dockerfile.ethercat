# syntax=docker/dockerfile:1
FROM dependencies AS ethercat

ARG MASTER_VERSION=1.0.0
ARG BUILD_JOBS=4
ARG BUILD_GUI=ON
ARG SOEM_REF=xeno3
ARG CPPZMQ_REF=master
ARG MATLOGGER_REF=master
ARG ECAT_CLIENT_REF=main

ENV ECAT_INSTALL_PREFIX=/ws/code_ws/install
ENV CMAKE_PREFIX_PATH=/ws/code_ws/install
ENV LD_LIBRARY_PATH=/ws/code_ws/install/lib

WORKDIR /ws/code_ws

RUN git clone https://github.com/alessiomargan/SOEM.git src/SOEM \
    && git -C src/SOEM checkout "${SOEM_REF}"
RUN git clone https://github.com/zeromq/cppzmq.git src/cppzmq \
    && git -C src/cppzmq checkout "${CPPZMQ_REF}"
RUN git clone https://github.com/ADVRHumanoids/MatLogger2.git src/MatLogger2 \
    && git -C src/MatLogger2 checkout "${MATLOGGER_REF}" \
    && git -C src/MatLogger2 submodule update --init --recursive
RUN git clone https://github.com/Advanced-Robotics-Facility/ecat-client-advr.git src/ecat-client-advr \
    && git -C src/ecat-client-advr checkout "${ECAT_CLIENT_REF}" \
    && git -C src/ecat-client-advr submodule update --init --recursive

RUN mkdir -p install \
    && curl --fail --location --retry 3 \
      "https://github.com/Advanced-Robotics-Facility/xenomai-ethercat-setup/releases/download/master-v${MASTER_VERSION}/ecat-master-${MASTER_VERSION}-ubuntu24.04-amd64-nrt.tar.gz" \
      -o /tmp/ecat-master.tar.gz \
    && tar --no-same-owner -xzf /tmp/ecat-master.tar.gz -C install \
    && test -x install/bin/repl \
    && rm /tmp/ecat-master.tar.gz

RUN cmake -S src/SOEM -B build/SOEM \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${ECAT_INSTALL_PREFIX} \
      -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_USE_XENOMAI=OFF \
    && cmake --build build/SOEM --parallel ${BUILD_JOBS} \
    && cmake --install build/SOEM

RUN cmake -S src/cppzmq -B build/cppzmq \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${ECAT_INSTALL_PREFIX} \
      -DCMAKE_INSTALL_LIBDIR=lib -DCPPZMQ_BUILD_TESTS=OFF -DBUILD_TESTING=OFF \
    && cmake --build build/cppzmq --parallel ${BUILD_JOBS} \
    && cmake --install build/cppzmq

RUN cmake -S src/MatLogger2 -B build/MatLogger2 \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${ECAT_INSTALL_PREFIX} \
      -DCMAKE_INSTALL_LIBDIR=lib -DCOMPILE_PY_BINDINGS=OFF -DGEN_DEB=OFF -DGEN_DOCS=OFF \
    && cmake --build build/MatLogger2 --parallel ${BUILD_JOBS} \
    && cmake --install build/MatLogger2

RUN cmake -S src/ecat-client-advr -B build/ecat-client-advr \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${ECAT_INSTALL_PREFIX} \
      -DCMAKE_INSTALL_LIBDIR=lib -DENABLE_XENO=OFF -DCMAKE_USE_XENOMAI=OFF \
      -DCOMPILE_GUI=${BUILD_GUI} -DCOMPILE_MATLAB=OFF \
    && cmake --build build/ecat-client-advr --parallel ${BUILD_JOBS} \
    && cmake --install build/ecat-client-advr